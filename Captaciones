import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import linregress

# Cargar CSV
df = pd.read_csv( r"C:\Users\cadam\Downloads\palafolls_pouA.csv.xls",
    sep=";"
)

# Limpiar nombres de columnas
df.columns = df.columns.str.strip()

# Reemplazar coma decimal por punto y convertir a float
for col in ["t", "S- B", "S - C"]:
    df[col] = (
        df[col]
        .astype(str)
        .str.replace(",", ".", regex=False)
        .replace("nan", np.nan)
        .astype(float)
    )

# Tiempo en minutos
df["t_min"] = df["t"] / 60

pozos = {
    "B": {"r": 91, "col": "S- B"},
    "C": {"r": 55, "col": "S - C"}
}

caudales = {
    "Q1": 265 / 3600,   # m3/s
    "Q2": 400 / 3600,
    "Q3": 500 / 3600
}

def cooper_jacob(t, s, Q, r):
    """
    t : tiempo (min)
    s : descenso (m)
    Q : caudal (m3/s)
    r : distancia al pozo (m)
    """
    logt = np.log10(t)

    slope, intercept, r_value, _, _ = linregress(logt, s)

    # Transmisividad (m2/s)
    T = (2.3 * Q) / (4 * np.pi * slope)

    # Pasar a m2/día
    T_dia = T * 86400

    # Coeficiente de almacenamiento
    S = (4 * T / r**2) * 10 ** (-intercept / slope)

    return T_dia, S, slope, intercept, r_value**2

resultados = []

for q_label, Q in caudales.items():
    for pozo, info in pozos.items():

        # Filtrar datos
        data = df[
            (df["Q"] == q_label) &
            (df[info["col"]].notna()) &
            (df["t_min"] > 0)
        ]

        if len(data) < 5:
            continue

        # Ordenar por tiempo
        data = data.sort_values("t_min")

        t = data["t_min"]
        s = data[info["col"]]

        # Seleccionar tramo intermedio (20%–60%)
        n = len(data)
        i1 = int(0.2 * n)
        i2 = int(0.6 * n)

        t_sel = t.iloc[i1:i2]
        s_sel = s.iloc[i1:i2]

        if len(t_sel) < 3:
            continue

        # Calcular Cooper-Jacob
        T_dia, S, slope, intercept, R2 = cooper_jacob(
            t_sel, s_sel, Q, info["r"]
        )

        # ---- Gráfica ----
        plt.figure()

        # Datos completos
        plt.semilogx(t, s, "o", label="Datos")

        # Puntos usados en el ajuste
        plt.semilogx(t_sel, s_sel, "ro", label="Usados en ajuste")
        
        # Recta Cooper-Jacob
        t_linea = np.linspace(t_sel.min(), t_sel.max(), 100)
        s_linea = slope * np.log10(t_linea) + intercept
        plt.semilogx(t_linea, s_linea, "-", label="Ajuste Cooper-Jacob")
        
        # Etiquetas
        plt.xlabel("Tiempo (min)")
        plt.ylabel("Descenso (m)")
        plt.title(f"Pozo {pozo} – {q_label}")
        plt.legend()
        plt.grid(True)

        # Ecuación en la gráfica
        ecuacion = f"s = {slope:.3f} · log10(t) + {intercept:.3f}"
        plt.text(
            0.05, 0.95,
            ecuacion,
            transform=plt.gca().transAxes,
            fontsize=9,
            verticalalignment="top",
            bbox=dict(boxstyle="round", facecolor="white", alpha=0.8)
        )

        plt.show()

        resultados.append({
            "Pozo": pozo,
            "Caudal": q_label,
            "T (m2/día)": T_dia,
            "S (-)": S,
            "R2": R2,
            "Ecuación ajuste": ecuacion
        })
        df_res = pd.DataFrame(resultados)

print("\nRESULTADOS COOPER–JACOB\n")
print(df_res)

# =============================
# EFICIENCIA DEL POZO (JACOB)
# =============================

# Descensos estabilizados en el pozo bombeado (m)

s2 =  7.08
s3 =  8.67

# Caudales del ensayo escalonado (m3/h)
Q_eff = np.array([ 400, 500])

# Descensos estabilizados en el pozo bombeado (m)
# <-- CAMBIA estos valores por los tuyos
s_eff = np.array([ s2, s3])

# s/Q
s_Q = s_eff / Q_eff

# Ajuste lineal: s/Q = B + C·Q
slope, intercept, r_value, _, _ = linregress(Q_eff, s_Q)

B = intercept
C = slope

# Eficiencia por escalón
eficiencia = (B * Q_eff) / (B * Q_eff + C * Q_eff**2) * 100

# Tabla resultados
df_eff = pd.DataFrame({
    "Q (m3/h)": Q_eff,
    "s (m)": s_eff,
    "Eficiencia (%)": eficiencia.round(1)
})

print("\nEFICIENCIA DEL POZO\n")
print(df_eff.to_string(index=False))
print("\nB =", round(B, 5))
print("C =", round(C, 6))
print("R2 =", round(r_value**2, 3))

# Gráfica s/Q vs Q
plt.figure()
plt.plot(Q_eff, s_Q, "o", label="Datos")
plt.plot(Q_eff, B + C * Q_eff, "-", label="Ajuste")
plt.xlabel("Caudal Q (m3/h)")
plt.ylabel("s / Q (m)")
plt.legend()
plt.grid(True)

plt.savefig("Eficiencia_Pozo.png", dpi=300, bbox_inches="tight")
plt.show()

print("B =", B)
print("C =", C)
print("R2 =", r_value**2)